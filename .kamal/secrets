# Secrets for config/deploy.yml (env/secret and accessories/*/env/secret). This file is committed,
# so it only says WHERE each secret comes from. DO NOT ENTER RAW CREDENTIALS HERE!
#
# Both key files are git-ignored (/config/*.key). Keep a copy of each somewhere safe (a password
# manager): without master.key the credentials can't be decrypted, and without the database password
# the app can't reach its data.

RAILS_MASTER_KEY=$(cat config/master.key)

# Generated once with: openssl rand -hex 32 > config/database_password.key
CAR_WASH_DATABASE_PASSWORD=$(cat config/database_password.key)
POSTGRES_PASSWORD=$CAR_WASH_DATABASE_PASSWORD
