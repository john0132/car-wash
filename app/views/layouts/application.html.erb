<%# Public website layout: loads the SSR-enabled website.tsx Inertia entrypoint. %>
<%# Also used by `inertia` routes (InertiaRails::StaticController inherits InertiaController). %>
<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= vite_tags "application.css", "website.tsx" %>
    <%= inertia_ssr_head %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
